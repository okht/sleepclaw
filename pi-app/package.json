{
  "name": "sleepclaw-desktop",
  "productName": "SleepClaw",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first personal sleep investigation powered by Pi",
  "author": "SleepClaw contributors",
  "license": "MIT",
  "main": ".webpack/main",
  "scripts": {
    "prestart": "node scripts/runtime.cjs",
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "package": "electron-forge package --platform=win32 --arch=x64",
    "make": "electron-forge make --platform=win32 --arch=x64",
    "cli": "tsx src/cli.ts",
    "tools": "tsx src/tools-cli.ts",
    "mcp": "tsx src/tools-cli.ts mcp",
    "plugin:build": "tsx scripts/build-plugin.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.21",
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "i18next": "25.5.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "15.7.3",
    "sax": "1.6.1",
    "simple-statistics": "7.12.0",
    "typebox": "1.3.34",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron/asar": "3.4.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sax": "1.2.7",
    "@types/yauzl": "2.10.3",
    "css-loader": "7.1.2",
    "electron": "44.4.3",
    "esbuild": "0.25.12",
    "style-loader": "4.0.0",
    "ts-loader": "9.5.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "webpack": "5.102.1",
    "webpack-cli": "6.0.1"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
